# Copy to .env and adjust. Never commit your real .env.

# Bind address / port for the server (used by run.sh and Docker).
HOST=127.0.0.1
PORT=8000

# Where the SQLite database is stored.
DATA_DIR=./data

# Scope guard rail. Leave false to restrict scanning to private/internal
# ranges. Set true ONLY when you are authorised to assess external targets.
ALLOW_EXTERNAL=false

# Add authorised ranges beyond the built-in private ones (comma separated).
# EXTRA_SCOPE_CIDRS=203.0.113.0/24,198.51.100.7/32

# Maximum scans allowed to run at once.
MAX_CONCURRENT_SCANS=4
